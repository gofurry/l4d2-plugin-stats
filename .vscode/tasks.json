{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "L4D2 Stats: Build",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "L4D2 Stats: Build and Deploy",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/deploy.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "L4D2 Stats: Package",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/package.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "L4D2 Stats: Test SQLite migration",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/test_sqlite_migration.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "L4D2 Stats: Validate Versus contract",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/scripts/validate_versus_contract.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Dashboard: API Dev",
      "type": "shell",
      "command": "go",
      "args": [
        "run",
        "./cmd/l4d2-stats",
        "serve",
        "--config",
        "./config.yaml"
      ],
      "options": {
        "cwd": "${workspaceFolder}/dashboard"
      },
      "problemMatcher": []
    },
    {
      "label": "Dashboard: Frontend Dev",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "options": {
        "cwd": "${workspaceFolder}/dashboard/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Dashboard: Verify and Build",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build-dashboard.ps1"
      ],
      "problemMatcher": []
    }
  ]
}
