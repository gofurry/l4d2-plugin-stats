"Databases"
{
    // Choose exactly one driver configuration and name it l4d2_player_stats.

    // SQLite: creates addons/sourcemod/data/sqlite/l4d2_player_stats.sq3.
    "l4d2_player_stats"
    {
        "driver"    "sqlite"
        "database"  "l4d2_player_stats"
    }

    // MySQL example:
    // "l4d2_player_stats"
